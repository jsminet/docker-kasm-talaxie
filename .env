# Talaxie
TALAXIE_IMAGE=jsminet/docker-kasm-talaxie
TALAXIE_VERSION=20261020_1824-V8.9.0SNAPSHOT

# Talaxie existing version
TALAXIE_DI=TOS_DI
TALAXIE_ESB=TOS_ESB
TALAXIE_BD=TOS_BD

# Java setup
XMS=4g
XMX=8g

# Traefik DNS
TALAXIE_DNS=talaxie.localtest.me
ADMINER_UI_DNS=adminer.localtest.me

# Adminer
ADMINER_HTTP_PORT=8080

# Kasm 
# USER: kasm_user
VNC_PW=changeme
KASM_HTTP_PORT=6901

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_TCP_PORT=5432