# Par défaut, Git décide
* text=auto

# Scripts et fichiers lus sous Linux : toujours LF
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.py        text eol=lf
Makefile    text eol=lf

# Scripts Windows : toujours CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Fichiers binaires : jamais touchés
*.zip       binary
*.gz        binary
*.jar       binary
*.png       binary